# Contact form email delivery (Nodemailer + Gmail SMTP)
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored.
#
# These same three variables must also be set in Vercel:
#   Project Settings → Environment Variables
# Vercel does not read .env.local. Without them set there,
# contact form submissions will fail silently in production.

# Gmail address used to send contact form emails (also the SMTP login)
EMAIL_USER=you@gmail.com

# Gmail App Password — NOT your real Gmail password.
# Generate one at: myaccount.google.com → Security → 2-Step Verification → App passwords
# It will be 16 characters, no spaces.
EMAIL_PASSWORD=abcdabcdabcdabcd

# Inbox where contact form submissions are delivered.
# Can be the same as EMAIL_USER or any address you control.
RECIPIENT_EMAIL=you@gmail.com
